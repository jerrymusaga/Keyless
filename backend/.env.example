# Copy to .env and fill in the secrets. Everything not marked SECRET is public on-chain state,
# listed here so a fresh clone doesn't have to go digging for it.

# --- Network -----------------------------------------------------------------
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
COSTON_RPC=https://coston-api.flare.network/ext/C/rpc

# SECRET. Your funded Coston2 deployer key (NEVER commit the real .env).
PK=0x...

# SECRET. Optional: a Flare explorer API key, for contract verification.
FLARE_EXPLORER_KEY=

# --- Flare Confidential Compute ----------------------------------------------
# FlareTeeManager is a diamond; every facet is reached through this one address.
# Flare REDEPLOYED this on 2026-07-23. The old 0x004224fa… still has code and still answers calls —
# it just doesn't know our extension, so it returns the zero address and instructions go nowhere.
# That failure looks exactly like a bug in your own code. If the enclave never hears from you, or
# addTeeVersion reverts FunctionNotFound, check this address before anything else.
FLARE_TEE_MANAGER=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE

# Ours, from BootstrapExtension.s.sol. Registering an extension is permissionless.
EXTENSION_ID=65645

# The TEE image our machines must attest to.
TEE_CODE_HASH=0x194844cf417dde867073e5ab7199fa4d21fd82b5dbe2bdea8b3d7fc18d10fdc2
TEE_VERSION=keyless-v1

# --- Keyless core ------------------------------------------------------------
# The multi-tenant account manager: every wallet's key obeys this contract and nothing else.
# Set after deploying, then run BootstrapExtension.s.sol:BindPolicy.
KEYLESS_ACCOUNTS=0x57eb332D7000752ee82a35cc1A75941F0a619979
KEYLESS_VERIFIER=

# --- Policy rules ------------------------------------------------------------
# One contract per policy; a wallet points at exactly one. Keep these current — a stale address here
# reads as a broken contract rather than a stale variable, which is a bad hour to spend.
EXCHANGE_RULE=0x2E5e2A1055670b2bc2baBd64f15825e69512d7e4
RATELIMIT_RULE=0x51Cc5c71350d527fDaA188B39f28DE22F4873710
CONDITIONAL_RULE=0x2d8517BC464C70c21bBDBA48d3166a77A5019E77
SCHEDULED_RULE=0x3C1B2a200137e0E01589f50C469f410706E20177
FXRP_RULE=0x12AdbaAbE8409fF2f7B8f12e680a6E5698a7D2eE

# Retired, but still deployed and still governing accounts created on them. Kept so those accounts
# stay explicable, NOT for new deployments.
#   AllowlistRule    0x7aE1dC15Acd4766132ac11A67DfdCde03bd8DeC2  (folded into EXCHANGE_RULE)
#   SubscriptionRule 0xa828482FaB7c149AA6D339b31016cf0d7165AeDc  (folded into RATELIMIT_RULE)
#   RateLimit v1     0xDED9303f6b72bd88c3F6a34414Ee2935422ab27d
#   FdcEscrowRule    0x6ef53Ce1FBDa8B13A2CCAE598a77A5bdC27402F7  (VULNERABLE — bound only the
#                                                                response, so any attestation of any
#                                                                API returning the same value could
#                                                                release it. Never point anything here.)

# --- FAssets / Flare Smart Accounts ------------------------------------------
# Resolve AssetManagerFXRP from FlareContractRegistry (0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019).
ASSET_MANAGER_FXRP=
# Where FXRP mints land and DeFi vaults live.
FSA_DIAMOND=0x434936d47503353f06750Db1A444DBDC5F0AD37c

# --- Executors (enclave/deploy/executor) -------------------------------------
# SECRET. A funded Coston2 key the watchers sign with. Deliberately NOT the deployer key.
# Set WATCHER to mint | conditional | scheduled to choose which watcher a service runs.
EXECUTOR_KEY=0x...
