# --- Network -----------------------------------------------------------------
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
COSTON_RPC=https://coston-api.flare.network/ext/C/rpc

# Your funded Coston2 deployer key (NEVER commit the real .env)
PK=0x...

# --- Flare Confidential Compute (FCE) ----------------------------------------
# FlareTeeManager is a diamond; every facet is reached through this one address.
# Hardcoded in the scripts; listed here for reference.
FLARE_TEE_MANAGER=0x004224fa1BF1Acd3D233f011FB03b8dd5fA5d41F

# Set from the output of BootstrapExtension.s.sol.
EXTENSION_ID=

# The TEE image our machines must attest to. Defaults to the reference fce-sign image
# (the one the live third-party machines on Coston2 run). Replace with our fork's hash.
TEE_CODE_HASH=0x194844cf417dde867073e5ab7199fa4d21fd82b5dbe2bdea8b3d7fc18d10fdc2
TEE_VERSION=keyless-v1

# Set after deploying the policy + verifier, then run BootstrapExtension.s.sol:BindPolicy.
KEYLESS_POLICY=
KEYLESS_VERIFIER=

# --- FAssets (flagship redemption policy) ------------------------------------
# Resolve AssetManagerFXRP from FlareContractRegistry (0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019).
ASSET_MANAGER_FXRP=

FLARE_EXPLORER_KEY=
