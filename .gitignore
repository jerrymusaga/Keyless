# Foundry
backend/out/
backend/cache/
backend/broadcast/
backend/lib/

# Node
frontend/node_modules/
frontend/dist/

# Next build output. The root one is a stray from running `next` outside frontend/;
# two trace files were committed that way before this rule existed.
.next/

# Env / secrets
# NOTE: .env.<chain> is where the funded deployer key goes (the enclave's scripts read it),
# so ignore every .env variant, not just bare .env. Only the example is tracked.
**/.env
**/.env.*
!**/.env.example

# Enclave: proxy config holds indexer DB credentials
enclave/config/proxy/*.toml
!enclave/config/proxy/*.toml.example

# Go build output
enclave/go/bin/

# Internal research & strategy notes — not published
docs/

# OS
.DS_Store

# Launch/marketing copy — drafts, threads, scripts. Deliberately not tracked: this is
# outward-facing wording that changes constantly and shouldn't be reviewed as code.
content/
